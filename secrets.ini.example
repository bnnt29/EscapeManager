; Copy this file as "secrets.ini" (it is excluded by .gitignore) and adjust it. platformio.ini reads it through
; "extra_configs"; EVERYTHING that must not be committed lives here, in ONE place:
;   * the builds get it through the ${secrets.*} references in the [env] section below,
;   * the maintenance tools (pio run -e update-auth-token ...) and the hardware test scripts
;     (scripts/hw_smoke.mjs ...) read the [secrets] section directly as their defaults.
; Alternatively the settings can be stored on the device (serial commands, setup form, network push);
; a value stored on the device wins over the build.
[secrets]
wifi_ssid = MeinNetz
wifi_password = MeinPasswort
; The token the installation uses. The repository's public default keeps a closed escape-room network
; working without setup; use your own (>= 20 characters; letters, digits and - _ . only, because the value
; goes through the compiler command line) for shared or less trusted networks.
auth_token = EscapeManager-Private-WLAN-Default-Token
; Plan-edit token: only holders may SEND plans to devices (the manager can always edit plans locally).
; Empty = every holder of the normal token may send plans. Same character rules as above.
edit_token =
; Setup network: a device that cannot reach its Wi-Fi opens "EscapeSetup-<device id>" with a configuration
; form. Empty = OPEN network (default); 8..63 characters = WPA2 with this password.
setup_ap_password =

[env]
build_flags =
  -DESCAPE_WIFI_SSID=\"${secrets.wifi_ssid}\"
  -DESCAPE_WIFI_PASSWORD=\"${secrets.wifi_password}\"
  -DESCAPE_AUTH_TOKEN=\"${secrets.auth_token}\"
  -DESCAPE_EDIT_TOKEN=\"${secrets.edit_token}\"
  -DESCAPE_SETUP_AP_PASSWORD=\"${secrets.setup_ap_password}\"
