; Kopie als "secrets.ini" anlegen (wird von .gitignore ausgeschlossen) und anpassen.
; Wird ueber "extra_configs" in platformio.ini eingelesen.
; Alternativ die Zugangsdaten per seriellem Kommando im NVS ablegen (siehe README).
[env]
build_flags =
  -DESCAPE_WIFI_SSID=\"MeinNetz\"
  -DESCAPE_WIFI_PASSWORD=\"MeinPasswort\"
  ; only for examples/host_wifi (a host program that owns Wi-Fi itself):
  -DHOST_WIFI_SSID=\"MeinNetz\"
  -DHOST_WIFI_PASSWORD=\"MeinPasswort\"
